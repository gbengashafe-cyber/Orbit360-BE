      "name": "1. GET ENDPOINTS - Form Initialization",
      "item": [
        {
          "name": "1.1 Get Current Employee Info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/employees/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "employees",
                "1"
              ]
            },
            "description": "Fetch current logged-in employee information\nDisplays: Full Name, ID, Department, Supervisor, Leave Entitlement"
          }
        },
        {
          "name": "1.2 Get Employee Leave Balance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/leaves/balance/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "leaves",
                "balance",
                "1"
              ]
            },
            "description": "Fetch leave balance breakdown by type\nReturns: Annual, Sick, Maternity, etc. with allocated/used/remaining"
          }
        },
        {
          "name": "1.3 Get All Employees (for Dropdowns)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/employees?page=1&rows=100",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "employees"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "rows",
                  "value": "100"
                }
              ]
            },
            "description": "Fetch all employees for supervisor & backup selection dropdowns"
          }
        }
      ],
      "description": "These endpoints populate the leave form when it opens"
    },
