    {
      "name": "4. ERROR HANDLING - Test Cases",
      "item": [
        {
          "name": "4.1 Error - Missing Required Field (endDate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": 1,\n  \"type\": \"vacation\",\n  \"startDate\": \"2024-02-15\",\n  \"reason\": \"Family vacation\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/leaves",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "leaves"
              ]
            },
            "description": "Expected: 400 Bad Request - 'endDate is required'"
          }
        },
        {
          "name": "4.2 Error - Invalid Date Range (endDate < startDate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": 1,\n  \"type\": \"vacation\",\n  \"startDate\": \"2024-02-20\",\n  \"endDate\": \"2024-02-15\",\n  \"reason\": \"Invalid date range\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/leaves",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "leaves"
              ]
            },
            "description": "Expected: 400 Bad Request - 'endDate must be after startDate'"
          }
        },
        {
          "name": "4.3 Error - Invalid Employee ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": 99999,\n  \"type\": \"vacation\",\n  \"startDate\": \"2024-02-15\",\n  \"endDate\": \"2024-02-20\",\n  \"reason\": \"Invalid employee\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/leaves",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "leaves"
              ]
            },
            "description": "Expected: 400 Bad Request or 404 Not Found - 'Employee not found'"
          }
        },
        {
          "name": "4.4 Error - Insufficient Leave Balance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": 1,\n  \"type\": \"vacation\",\n  \"startDate\": \"2024-02-15\",\n  \"endDate\": \"2024-03-20\",\n  \"reason\": \"Requesting more than available balance\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/leaves",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "leaves"
              ]
            },
            "description": "Expected: 400 Bad Request - 'Insufficient leave balance. Available: 21 days, Requested: 34 days'"
          }
        },
        {
          "name": "4.5 Error - Unauthorized (Missing Token)",
          "request": {
            "method": "POST",
            "header": [
