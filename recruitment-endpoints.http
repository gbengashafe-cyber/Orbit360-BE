### Recruitment API Test Endpoints

@baseUrl = http://localhost:3000/api/v1/recruitment

### Get Dashboard Stats
GET {{baseUrl}}/dashboard/stats

### Create Job Posting
POST {{baseUrl}}/postings
Content-Type: application/json

{
  "title": "Senior Software Engineer",
  "description": "We are looking for an experienced software engineer with 5+ years of experience.",
  "department": "Engineering",
  "location": "San Francisco, CA",
  "employment_type": "full_time",
  "salary_range_min": 120000,
  "salary_range_max": 180000,
  "requirements": "JavaScript, React, Node.js, TypeScript, AWS",
  "created_by": "hr@example.com"
}

### Get All Job Postings
GET {{baseUrl}}/postings?page=1&rows=10

### Get All Active Job Postings
GET {{baseUrl}}/postings?page=1&rows=10&status=active

### Get Job Posting by ID
GET {{baseUrl}}/postings/1

### Update Job Posting
PUT {{baseUrl}}/postings/1
Content-Type: application/json

{
  "title": "Senior Software Engineer (Updated)",
  "salary_range_min": 130000,
  "salary_range_max": 200000
}

### Approve Job Posting (MD)
POST {{baseUrl}}/postings/1/approve
Content-Type: application/json

{
  "approved_by": "md@example.com"
}

### Reject Job Posting
POST {{baseUrl}}/postings/1/reject

### Close Job Role
POST {{baseUrl}}/postings/1/close

### Delete Job Posting
DELETE {{baseUrl}}/postings/1

---

### Submit Job Application
POST {{baseUrl}}/applications
Content-Type: application/json

{
  "job_posting_id": 1,
  "applicant_name": "John Doe",
  "applicant_email": "john@example.com",
  "applicant_phone": "+1-555-123-4567",
  "resume_url": "https://example.com/resumes/john-doe.pdf",
  "cover_letter": "I am very interested in this position as it aligns perfectly with my career goals and experience."
}

### Get All Job Applications
GET {{baseUrl}}/applications?page=1&rows=10

### Get Applications for Specific Job Status
GET {{baseUrl}}/applications?page=1&rows=10&status=applied

### Get Applications for Specific Job Posting
GET {{baseUrl}}/applications/by-posting/1?page=1&rows=10

### Get Application by ID
GET {{baseUrl}}/applications/1

### Schedule Interview
POST {{baseUrl}}/applications/1/schedule-interview
Content-Type: application/json

{
  "interview_date": "2024-02-20T14:00:00Z",
  "interview_notes": "Phone screening with technical questions"
}

### Update Application Status
PUT {{baseUrl}}/applications/1/status
Content-Type: application/json

{
  "status": "under_review",
  "rating": 4
}

### Send Offer
POST {{baseUrl}}/applications/1/send-offer

### Hire Applicant
POST {{baseUrl}}/applications/1/hire

### Reject Applicant
POST {{baseUrl}}/applications/1/reject

### Delete Application
DELETE {{baseUrl}}/applications/1

---

### Dashboard Workflow Example

# Step 1: Get dashboard stats
GET {{baseUrl}}/dashboard/stats

# Step 2: Create a new job posting
POST {{baseUrl}}/postings
Content-Type: application/json

{
  "title": "Full Stack Developer",
  "description": "Build amazing web applications",
  "department": "Engineering",
  "location": "Remote",
  "employment_type": "full_time",
  "salary_range_min": 80000,
  "salary_range_max": 120000,
  "requirements": "React, Node.js, SQL, 3+ years",
  "created_by": "hr@example.com"
}

# Step 3: Approve the job (requires MD approval)
POST {{baseUrl}}/postings/1/approve
Content-Type: application/json

{
  "approved_by": "md@example.com"
}

# Step 4: Check dashboard stats again
GET {{baseUrl}}/dashboard/stats

# Step 5: Receive applications
POST {{baseUrl}}/applications
Content-Type: application/json

{
  "job_posting_id": 1,
  "applicant_name": "Jane Smith",
  "applicant_email": "jane@example.com",
  "applicant_phone": "+1-555-987-6543",
  "resume_url": "https://example.com/jane-resume.pdf",
  "cover_letter": "Excited about this opportunity!"
}

# Step 6: Schedule interview
POST {{baseUrl}}/applications/1/schedule-interview
Content-Type: application/json

{
  "interview_date": "2024-02-22T10:00:00Z",
  "interview_notes": "Technical interview - 1 hour"
}

# Step 7: Check dashboard stats (should show pending interview)
GET {{baseUrl}}/dashboard/stats

# Step 8: Hire applicant
POST {{baseUrl}}/applications/1/hire

# Step 9: Check final dashboard stats (hire rate should increase)
GET {{baseUrl}}/dashboard/stats
